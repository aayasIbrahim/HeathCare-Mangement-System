{
  "info": {
    "_postman_id": "b83f2f1d-0e57-4d72-a1d4- healthcare-api",
    "name": "Healthcare System API",
    "description": "Complete API collection for the PH Healthcare System backend. Start with Auth > Login as Tester Admin, Tester Doctor, or register and verify a patient. Protected requests use the captured accessToken automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is successful', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 399);",
          "});",
          "if (pm.response.headers.get('Content-Type') && pm.response.headers.get('Content-Type').includes('application/json')) {",
          "  const body = pm.response.json();",
          "  pm.test('JSON response has success flag', function () { pm.expect(body).to.have.property('success'); });",
          "  if (body.data && body.data.accessToken) pm.environment.set('accessToken', body.data.accessToken);",
          "  if (body.data && body.data.refreshToken) pm.environment.set('refreshToken', body.data.refreshToken);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "patientEmail", "value": "patient@example.com" },
    { "key": "patientPassword", "value": "Patient@123" },
    { "key": "otp", "value": "000000" },
    { "key": "scheduleId", "value": "replace-with-schedule-id" },
    { "key": "appointmentId", "value": "replace-with-appointment-id" },
    { "key": "paymentId", "value": "replace-with-payment-id" },
    { "key": "doctorId", "value": "replace-with-doctor-id" }
  ],
